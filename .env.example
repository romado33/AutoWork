# AutoWork configuration. Copy to .env and fill in.

# Required: OpenAI API key (platform.openai.com/api-keys)
OPENAI_API_KEY=

# Recorder volume serial. Find yours with:
#   Get-CimInstance Win32_LogicalDisk | Select DeviceID,VolumeSerialNumber
RECORDER_SERIAL=AA986EA1

# Summary email. SMTP_APP_PASSWORD must be a Google App Password,
# NOT your Gmail password: https://myaccount.google.com/apppasswords
# (requires 2-Step Verification enabled on the account)
SMTP_ADDRESS=
SMTP_APP_PASSWORD=
SUMMARY_TO=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Outlook desktop (already signed in) supplies meeting title and invitees when
# exactly one calendar event overlaps the recording. No extra credentials.
# The pipeline still runs if Outlook is missing or the lookup is ambiguous.

